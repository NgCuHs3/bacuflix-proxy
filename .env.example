# Bacuflix Reverse Proxy Environment Configuration

# Local development port (used when running 'node server.js' or 'npm run dev')
PORT=3000

# Upstream primary API base URL (default: KKPhim API)
UPSTREAM_BASE_URL=https://phimapi.com

# Allowed upstream hosts for proxying media, streams, images, and subtitles (comma-separated).
# Wildcard '*' can be used to allow any public host.
# Subdomains of listed domains are automatically allowed (e.g. s2.phim1280.tv is allowed by phim1280.tv).
ALLOWED_STREAM_HOSTS=phimapi.com,phimimg.com,phim1280.tv,kkphimplayer6.com,kvp726.com,apiaz.xyz,abfedgecanme.com,streamc.xyz,streamvsmov.com,vsmov.com,phim.nguonc.com,opstream.com,opstream1.com,opstream2.com,opstream3.com,bytefury.top,123embed.net,subtitle.123embed.net,raw.githubusercontent.com

# Allowed CORS origins ('*' allows all origins; or specify comma-separated origins)
CORS_ORIGIN=*

# Upstream request timeout in milliseconds
REQUEST_TIMEOUT_MS=15000
